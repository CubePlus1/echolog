{
  "manifestVersion": 1,
  "id": "screen-time",
  "version": "1.0.0",
  "apiVersion": "1",
  "displayName": "Screen Time",
  "description": "Passive foreground tracking, classification, and opt-in AI screen understanding",
  "entries": {
    "server": "./dist/index.js",
    "cli": "./dist/cli.js",
    "web": "/plugins/screen-time/index.js"
  },
  "capabilities": [
    "screen-usage",
    "daily-report",
    "screen-understanding"
  ],
  "permissions": [
    "database:plugin",
    "process:exec"
  ],
  "requires": {
    "coreApi": "^1.0.0",
    "platforms": [
      "darwin"
    ],
    "executables": [
      "lsappinfo",
      "ioreg",
      "pmset"
    ]
  },
  "configSchema": "./config.schema.json"
}
