{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echolog.local/plugins/screen-time/config.schema.json",
  "title": "Screen Time plugin configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sample_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300,
      "default": 5
    },
    "idle_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 86400,
      "default": 180
    },
    "macos_helper_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/.*\\/EchoLogScreenCapture\\.app/Contents/MacOS/echolog-screen-capture$",
      "description": "Optional absolute path to the packaged EchoLog screen-capture inner executable"
    }
  }
}
