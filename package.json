{
  "name": "echolog",
  "version": "0.2.0",
  "description": "Local-first developer activity recorder and review engine",
  "type": "module",
  "bin": {
    "el": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/server/app.ts",
    "build": "pnpm --filter @echolog/plugin-sdk build && pnpm --filter @echolog/plugin-screen-time build && pnpm --filter @echolog/plugin-tmux-status build && tsup",
    "build:macos-capture": "bash scripts/build-macos-capture.sh",
    "build:macos-release": "pnpm build && pnpm build:macos-capture",
    "package:macos": "bash scripts/package-release.sh --version 0.2.0 --adhoc",
    "cli": "tsx src/cli/index.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "test:integration": "pnpm build && tsx --test tests/**/*.integration.ts",
    "typecheck": "tsc --noEmit",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@echolog/plugin-screen-time": "workspace:*",
    "@echolog/plugin-sdk": "workspace:*",
    "@echolog/plugin-tmux-status": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/static": "^8.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "^13.1.0",
    "drizzle-orm": "^0.44.0",
    "ejs": "^3.1.10",
    "fastify": "^5.3.0",
    "nanoid": "^5.1.5",
    "node-notifier": "^10.0.1",
    "postgres": "^3.4.7",
    "yaml": "^2.7.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.15.0",
    "@types/node-notifier": "^8.0.5",
    "drizzle-kit": "^0.31.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
