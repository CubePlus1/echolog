{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echolog.local/schemas/echolog-plugin-v1.json",
  "title": "EchoLog Bundled Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "id",
    "version",
    "apiVersion",
    "displayName",
    "description",
    "entries",
    "capabilities",
    "permissions",
    "requires"
  ],
  "properties": {
    "manifestVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "apiVersion": { "const": "1" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 300 },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server": { "type": "string", "minLength": 1 },
        "cli": { "type": "string", "minLength": 1 },
        "web": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": ["process:exec", "database:plugin", "notifications:send"]
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coreApi"],
      "properties": {
        "coreApi": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "executables": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "configSchema": { "type": "string", "minLength": 1 }
  }
}
